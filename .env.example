# ============================================================================
# tbot configuration. Copy to .env (git-ignored). NEVER commit real keys.
# If a key has ever been pasted into a chat, screenshot, or ticket: rotate it.
# ============================================================================

# ---- Environment selection --------------------------------------------------
# paper (default) or live. Live also needs --live on the CLI, an armed state,
# a typed confirmation, and a healthy account. See LIVE_RUNBOOK.md.
TRADING_ENV=paper

# ---- Paper credentials (Alpaca dashboard -> Paper Trading -> API Keys) ------
# Paper key ids start with "PK". Endpoint: https://paper-api.alpaca.markets
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# ---- Live credentials (Alpaca dashboard -> Live Trading -> API Keys) --------
# Live key ids start with "AK". Endpoint: https://api.alpaca.markets
# Leave EMPTY until you have completed the paper phase and read LIVE_RUNBOOK.md.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Refuse a PK key in the live slot / an AK key in the paper slot.
STRICT_KEY_PREFIX_CHECK=true

# ---- Live safety -------------------------------------------------------------
# The live loop (multi-cycle) refuses to run unless this is true. `--once` cycles
# still require `python -m bot live arm` first. Default stays false.
LIVE_AUTONOMOUS_TRADING=false
LIVE_ARM_TTL_MINUTES=30

# SAFE_LIVE_TEST_MODE: hard caps for a tiny engineering-validation account.
# The bot can never raise these; only you can, by editing this file.
SAFE_LIVE_TEST_MODE=true
SAFE_MAX_ORDER_NOTIONAL=25        # dollars per order
SAFE_MAX_GROSS_EXPOSURE=50        # dollars, sum of |position notional|
SAFE_MAX_DAILY_LOSS=5             # dollars below the day's starting equity -> no new entries
SAFE_MAX_ACCOUNT_DRAWDOWN=10      # dollars below peak equity -> kill switch
SAFE_MAX_POSITIONS=1
SAFE_ALLOWED_SYMBOLS=SPY,QQQ      # comma-separated allow-list (empty = any fractionable US equity)

# ---- Data ---------------------------------------------------------------------
# sip = consolidated tape (free plan: only data older than 15 min), iex = IEX only.
DATA_FEED=sip
# split | all | raw | dividend   (all = split + dividend adjusted)
DATA_ADJUSTMENT=split
DATA_DB_PATH=data_cache/bars.duckdb
MAX_STALE_DATA_SECONDS=900

# ---- Risk (shared by backtest and execution) ----------------------------------
RISK_PER_TRADE_PCT=0.01        # 1% of equity risked per trade (fixed fractional)
MAX_POSITION_PCT=0.50          # cap a single position at 50% of equity
DAILY_LOSS_LIMIT_PCT=0.03      # stop opening trades for the day after -3%
MAX_DRAWDOWN_PCT=0.20          # kill switch: liquidate and halt at -20% from peak
MAX_POSITIONS=5
ATR_STOP_MULT=2.0              # protective stop = entry - 2*ATR(14)
ALLOW_FRACTIONAL=true          # fractional shares (Alpaca: DAY market orders only, fractionable assets only)
QTY_DECIMALS=3
MAX_SPREAD_BPS=50              # reject orders when the quoted spread is wider than this
MAX_PRICE_DEVIATION_PCT=0.10   # reject orders when the quote is >10% away from the last close

# ---- Costs (backtest) -----------------------------------------------------------
SLIPPAGE_BPS=2.0
SPREAD_BPS=2.0
COMMISSION_PER_SHARE=0.0

# ---- Execution ------------------------------------------------------------------
# opg = market-on-open (whole shares; submitted 19:00-09:28 ET, fills in the opening auction)
# day = plain market order (required for fractional quantities; submitted while the market is open)
ORDER_TIME_IN_FORCE=opg
POLL_INTERVAL_SECONDS=300
STATE_DIR=state

# ---- Research-only flags (no effect on execution) -------------------------------
ENABLE_JEV=false
JEV_ENDPOINT=
JEV_API_KEY=
ENABLE_KELLY=false

# ---- Monitoring -----------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
# Optional. Leave empty to disable Discord alerts.
DISCORD_WEBHOOK_URL=
