# ---- Alpaca (paper) -------------------------------------------------------
# Get free paper keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Paper endpoint. Never change this unless you know exactly what you're doing.
ALPACA_PAPER_URL=https://paper-api.alpaca.markets

# ---- Safety ---------------------------------------------------------------
# Real-money trading is OFF. Setting this to true is not enough on its own:
# the CLI also requires --i-understand-live-trading and an interactive "LIVE" confirmation.
LIVE_TRADING=false

# ---- Data -----------------------------------------------------------------
# sip = consolidated tape (free plan: only data older than 15 min), iex = IEX only.
DATA_FEED=sip
# split | all | raw   (all = split + dividend adjusted)
DATA_ADJUSTMENT=split
DATA_DB_PATH=data_cache/bars.duckdb

# ---- Risk -----------------------------------------------------------------
RISK_PER_TRADE_PCT=0.01        # 1% of equity risked per trade (fixed fractional)
MAX_POSITION_PCT=0.50          # cap a single position at 50% of equity
DAILY_LOSS_LIMIT_PCT=0.03      # stop opening trades for the day after -3%
MAX_DRAWDOWN_PCT=0.20          # kill switch: liquidate and halt at -20% from peak
MAX_POSITIONS=5
ATR_STOP_MULT=2.0              # protective stop = entry - 2*ATR(14)

# ---- Costs (backtest) -----------------------------------------------------
SLIPPAGE_BPS=2.0
SPREAD_BPS=2.0
COMMISSION_PER_SHARE=0.0

# ---- Execution ------------------------------------------------------------
# opg = market-on-open (submitted after 19:00 ET, fills at the next open auction)
# day = plain market order (fills immediately if the market is open)
ORDER_TIME_IN_FORCE=opg
POLL_INTERVAL_SECONDS=300
STATE_DIR=state

# ---- Monitoring -----------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
# Optional. Leave empty to disable Discord alerts.
DISCORD_WEBHOOK_URL=
