[Unit]
Description=tbot V1.5 watchdog (independent of the daemon)
After=network-online.target tbot.service
Wants=network-online.target

[Service]
Type=simple
User=tbot
Group=tbot
WorkingDirectory=/opt/tbot
EnvironmentFile=/etc/tbot/env
ExecStart=/opt/tbot/.venv/bin/python -m bot watchdog --config config/watchdog.yaml
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tbot/state /opt/tbot/logs

[Install]
WantedBy=multi-user.target
